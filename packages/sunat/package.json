{
  "name": "@rodatech/sunat",
  "version": "0.0.0",
  "private": true,
  "description": "Conector de facturación electrónica SUNAT (Perú). Genera UBL 2.1, firma XML-DSig, envía por SOAP y procesa el CDR. Sin acoplamiento a la app: recibe objetos de dominio, devuelve XML y CDR. Diseñado para copiarse y personalizarse en otros proyectos.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./catalogos": "./src/catalogos/index.ts",
    "./dominio": "./src/dominio/index.ts",
    "./impresion": "./src/impresion/index.ts",
    "./guia": "./src/dominio/guia.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
