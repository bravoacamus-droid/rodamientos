# ---------------------------------------------------------------------------
# Aplicación · requeridas en local y en el despliegue (Vercel)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ---------------------------------------------------------------------------
# Alta de usuarios desde Configuración · opcional.
# Crear cuentas exige la Admin API de Supabase, que solo acepta esta clave.
# Cárguela como variable de SERVIDOR (sin el prefijo NEXT_PUBLIC_): nunca llega
# al navegador. Sin ella el ERP funciona igual, salvo el alta de usuarios.
# También la usan los scripts locales de siembra.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_PROJECT_REF=ref_del_proyecto
SUPABASE_MGMT_TOKEN=sbp_tu_personal_access_token
