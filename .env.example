# ---------------------------------------------------------------------------
# Aplicación · requeridas en local y en el despliegue (Vercel)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ---------------------------------------------------------------------------
# Servidor · nunca con el prefijo NEXT_PUBLIC_, nunca en el bundle del cliente.
# La service_role salta RLS por completo: solo la usan route handlers que ya
# verificaron el rol de quien llama, y los scripts locales de siembra.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ---------------------------------------------------------------------------
# Migraciones · solo local. Basta con UNA de las dos vías.
#
#   SUPABASE_DB_URL   preferida. Dashboard → Project Settings → Database →
#                     Connection string (URI). Permite transacciones reales.
#
#   MGMT_TOKEN + REF  alternativa por Management API.
#                     Dashboard → Account → Access Tokens.
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_ACCESS_TOKEN=sbp_tu_personal_access_token
SUPABASE_PROJECT_REF=ref_del_proyecto

# `SUPABASE_MGMT_TOKEN` sirve como alias de SUPABASE_ACCESS_TOKEN en los dos
# scripts (aplicar-migraciones y generar-tipos). No hace falta poner las dos.

# ---------------------------------------------------------------------------
# Consultas RUC / DNI · Decolecta. 100 consultas mensuales en el plan gratuito,
# por eso el paquete @rodatech/consultas lleva control de cuota propio.
#
# SIN TOKEN NO REVIENTA NADA: el alta de clientes y proveedores degrada a
# «escribe la razón social a mano» y avisa en pantalla. Por eso se lee con
# `envOpcional` y no con `requerirEnv`. Si en local sale «No hay token de
# Decolecta configurado» al pulsar «Traer», es esto y solo esto.
# ---------------------------------------------------------------------------
DECOLECTA_TOKEN=tu_token_decolecta

# Las cuatro de abajo son OPCIONALES: si no están se usan estos mismos valores.
# Solo se tocan al cambiar de plan, y cambiar de plan es cambiar el número —no
# hay que tocar código.
#   DECOLECTA_PLAN=free              etiqueta, solo informativa
#   DECOLECTA_QUOTA_LIMIT=100        consultas del ciclo
#   DECOLECTA_QUOTA_RESERVE_PCT=5    % final reservado a lo crítico (facturar)
#   DECOLECTA_QUOTA_CYCLE_DAY=1      día del mes en que reinicia el ciclo
#   DECOLECTA_TIMEOUT_MS=10000       corte de la llamada a Decolecta

# ---------------------------------------------------------------------------
# Facturación electrónica SUNAT.
#
# Las credenciales YA NO van aquí: se cargan desde Configuración → Facturación
# y se guardan cifradas en `config_sunat_secretos`, una tabla que solo alcanza
# el servidor. Lo único que hace falta en el entorno es la llave con la que se
# cifran.
#
# Generar UNA vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# TIENE que ser idéntica en local, en Vercel y en CI. Con otra llave, lo que
# esté guardado no se puede descifrar y hay que volver a escribirlo a mano: no
# hay forma de recuperarlo. No la pierdas y no la regeneres.
# ---------------------------------------------------------------------------
SUNAT_ENCRYPTION_KEY=

# Respaldo solo para arrancar sin pasar por el panel. Si están puestas, se usan
# cuando la configuración de la base está vacía. El certificado va como base64
# del .pfx porque Vercel no admite archivos:
#   node -e "console.log(require('fs').readFileSync('cert.pfx').toString('base64'))"
# El usuario SOL es SECUNDARIO y va en formato RUC + usuario (20XXXXXXXXXMODDATOS).
SUNAT_AMBIENTE=beta
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_CERT_PFX_BASE64=
SUNAT_CERT_CLAVE=

# Atajos de acceso del login, uno por rol.
#
# En local se activan solos. En un despliegue de pruebas hay que pedirlos a
# mano, porque Vercel compila con NODE_ENV=production aunque sea un preview.
# Se BORRA en la entrega: mientras esté, cualquiera con la URL entra con un clic.
RODATECH_ATAJOS=1
RODATECH_DEV_PASSWORD=la_clave_de_las_cuentas_sembradas

# ---------------------------------------------------------------------------
# Pruebas de punta a punta (`pnpm e2e`). Ninguna de las dos hace falta para
# desarrollar; las dos hacen falta para probar el flujo del dinero.
# ---------------------------------------------------------------------------
#
# E2E_BASE_URL   contra qué servidor corre Playwright. Sin ella levanta uno
#                propio en el 4005; con ella reutiliza el que ya tengas abierto,
#                que es lo cómodo mientras se escriben pruebas.
#
# E2E_PERMITIR_ESCRITURA   el seguro de `e2e/guardia.ts`. Las pruebas que mutan
#                datos emiten documentos, queman correlativos y mueven stock, y
#                un correlativo NO se devuelve. La guardia se niega a correr
#                contra el Supabase del cliente —su `ref` está escrito en el
#                código, no leído del entorno— y aun apuntando a otro proyecto
#                exige que lo digas a propósito con un 1.
#
# O sea: primero crear el proyecto Supabase de pruebas, aplicarle las
# migraciones con `pnpm db:aplicar`, apuntar ahí NEXT_PUBLIC_SUPABASE_URL, y
# solo entonces poner esto en 1.
E2E_BASE_URL=http://localhost:4005
E2E_PERMITIR_ESCRITURA=0
